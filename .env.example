# Get this from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Places — proxied via /api/places/* (was Supabase secret → google-places Edge Function)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Gemini — AI dish detection via /api/ai/* (was Supabase secret → analyze-dish Edge Function)
# Get from: Google AI Studio > API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase — server-side push notifications (was Supabase secrets → push notification Edge Functions)
# Get FIREBASE_PROJECT_ID from: Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=your_firebase_project_id_here
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the full service account JSON on a single line
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000
